# Kopieren nach .env und Werte setzen (chmod 600). Die Datei .env steht in .gitignore.
# Je Rolle ein eigenes, zufälliges Passwort, z. B.: openssl rand -base64 24
# pragma: allowlist nextline secret
POSTGRES_PASSWORD=bitte-setzen-admin
# pragma: allowlist nextline secret
IMPORT_PASSWORD=bitte-setzen-import
# pragma: allowlist nextline secret
LESE_PASSWORD=bitte-setzen-lesen

# Nur nötig, wenn der Server nur über einen Proxy ins Internet darf (z. B. Hochschulnetz):
# HTTPS_PROXY=http://proxy.example.org:3128
# NO_PROXY=weitere.interne.hosts

# So nennt sich die Pipeline in den Server-Logs der Anbieter (User-Agent). Mit eigenem Namen
# und Kontakt, damit sich ein Anbieter bei Problemen melden kann:
# PIPELINE_KENNUNG=MOSIDI-Import (+https://github.com/MOSIDI-ORG; kontakt@example.org)

# Nur für Prüfläufe ohne Netzabruf von INKAR: abgelegte Gesamtdatei unter cache/ (E50). Ohne diese Zeile lädt
# INKAR automatisch per URL mit der Freigabe aus config/quellen.yaml (Regelbetrieb):
# PIPELINE_INKAR_DATEI=/app/cache/inkar_2025.zip
